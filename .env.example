# FastAPI App Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Firebase Configuration
# Path to your firebase service account private key JSON file
FIREBASE_CREDENTIALS_PATH=app/firebase-credentials.json

# Firebase Database URL
FIREBASE_DATABASE_URL=https://hatchmate-iot-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Storage Bucket (do not include gs:// prefix)
FIREBASE_STORAGE_BUCKET=hatchmate-iot.appspot.com

# Camera Capture Settings
# 10800 seconds = 3 hours. Set to a smaller value (e.g. 30) for testing.
CAMERA_CAPTURE_INTERVAL_SECONDS=10800

